{
  "name": "refactor-blocks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "explore": "playwright test -c playwright.explore.config.ts",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run typecheck && npm test",
    "preview": "vite preview",
    "duplication-scan": "jscpd src --format \"typescript,tsx\" --ignore \"**/*.test.ts,**/*.test.tsx\" --reporters console,sarif --output report",
    "dead-code-scan": "knip",
    "stage-report": "vitest run src/infrastructure/stages/stageReport.test.ts -u"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@xyflow/react": "^12.11.5",
    "highlight.js": "^11.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.11.0",
    "jscpd": "^5.4.1",
    "jsdom": "^30.1.3",
    "knip": "^6.41.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.15",
    "jscpd-linux-x64-gnu": "5.4.2"
  }
}
